# URL del Google Apps Script Web App (termina en /exec)
# Ver google-apps-script/Code.gs y las instrucciones de despliegue
VITE_CONTACT_ENDPOINT=https://script.google.com/macros/s/AKfycbx.../exec

# Google Analytics 4 — Measurement ID (formato G-XXXXXXXXXX), es público, no es secreto
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Anthropic API key para scripts/campaign_research.py (NO llevar prefijo VITE_ -- eso la expondría al bundle del frontend)
ANTHROPIC_API_KEY=sk-ant-...

# Brave Search API key para scripts/campaign_research.py. Obtener en https://brave.com/search/api/
BRAVE_API_KEY=BSA...
